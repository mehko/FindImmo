        "new",
        "price_drop",
        "price_increase",
        "features_changed",
        "unavailable",
        "reappeared",
        "gone"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ListingEvent": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
